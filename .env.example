# Copie para .env e ajuste os valores.

# Chave usada para assinar sessoes e tokens de link do cliente.
SECRET_KEY=troque-esta-chave-por-uma-aleatoria-longa

# Credenciais do painel comercial (/admin).
ADMIN_USER=comercial@amglogistica.com.br
ADMIN_PASS=troque-esta-senha

# Envio de e-mail (Resend). Se RESEND_API_KEY ficar vazio, os e-mails
# sao apenas exibidos no console (modo desenvolvimento).
RESEND_API_KEY=
EMAIL_FROM=AMG Logística <onboarding@resend.dev>
EMAIL_COMERCIAL=comercial@amglogistica.com.br

# Destinatario do aviso interno de "OC enviada a Logistica" (Para / Cc).
EMAIL_LOGISTICA=josemarteixeiracosta@gmail.com
EMAIL_LOGISTICA_CC=comercial4@amglog.com.br

# Enquanto nenhum dominio proprio estiver verificado no Resend, a conta so
# entrega e-mail pro proprio dono da conta -- qualquer outro destinatario e
# rejeitado pela API. Preenchendo isto, TODO e-mail (cliente, comercial,
# logistica) e redirecionado pra ca, com o destinatario real anotado no
# assunto, em vez de falhar/nunca chegar. Deixe vazio (e remova essa var em
# producao) assim que um dominio for verificado em resend.com/domains.
EMAIL_DESTINO=

# URL publica base, usada para montar os links enviados por e-mail.
BASE_URL=http://localhost:8000

# Banco de dados. Default: SQLite local.
DATABASE_URL=sqlite:///./amg.db

# dev | prod
ENV=dev
