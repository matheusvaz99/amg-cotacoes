# Copie para .env e ajuste os valores.

# Chave usada para assinar sessoes e tokens de link do cliente.
SECRET_KEY=troque-esta-chave-por-uma-aleatoria-longa

# Credenciais do painel comercial (/admin).
ADMIN_USER=comercial@amglogistica.com.br
ADMIN_PASS=troque-esta-senha

# Envio de e-mail (Resend). Se RESEND_API_KEY ficar vazio, os e-mails
# sao apenas exibidos no console (modo desenvolvimento).
RESEND_API_KEY=
EMAIL_FROM=AMG Logistica <onboarding@resend.dev>
EMAIL_COMERCIAL=comercial@amglogistica.com.br

# URL publica base, usada para montar os links enviados por e-mail.
BASE_URL=http://localhost:8000

# Banco de dados. Default: SQLite local.
DATABASE_URL=sqlite:///./amg.db

# dev | prod
ENV=dev
